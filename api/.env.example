# Local development settings for the Innesto API (copy to api/.env; git-ignored).
# Production uses the same variable names via the docker env_file.

# Google OAuth 2.0 Web client id (GCP console → APIs & Services → Credentials).
# Authorized JavaScript origins must include http://localhost:5173 for local dev.
INNESTO_GOOGLE_CLIENT_ID=

# Who may sign in. Comma-separated. Empty = nobody.
INNESTO_ALLOWED_EMAILS=stevedperkins@gmail.com

# Access-token signing key. Optional locally (one is generated into data/jwt-secret);
# required in production:  openssl rand -hex 32
INNESTO_JWT_SECRET=

# ct2 (self-hosted models) | echo (dev stub) | none (candidates only)
INNESTO_TRANSLATION_ENGINE=ct2
